{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shm-nexus",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "nexusshm.dpdns.org",
      "zone_name": "nexusshm.dpdns.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "TURSO_DATABASE_URL": "PLACEHOLDER_TURSO_DATABASE_URL",
    "TURSO_AUTH_TOKEN": "PLACEHOLDER_TURSO_AUTH_TOKEN"
  }
}
